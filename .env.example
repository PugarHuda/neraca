# Comments live on their own line: an inline "# ..." after an empty value
# becomes part of the value once this file is loaded.

# ---- Base wallet: pick ONE of the two blocks ----

# (a) No portal, no account. `python -m neraca.onchain wallet` mints the pair
#     and prints the faucet links. NERACA_VAULT is any second address you
#     control - the guarantee is escrowed there.
NERACA_STAKE_KEY=
NERACA_VAULT=

# (b) CDP server wallets - free keys from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ---- x402 storefront ----
# NERACA_PAY_TO: MAKELAR's wallet address (printed by `onchain wallet`)
# NERACA_BUYER_KEY: a Base Sepolia key holding test USDC, for the paying client
NERACA_PAY_TO=
NERACA_RISK_PRICE=$0.05
NERACA_BUYER_KEY=

# ---- Virtuals ACP ----
# Register agents at https://app.virtuals.io/acp/new (Signers tab).
# ACP_TESTNET: 1 = Base Sepolia, empty = Base mainnet sandbox.
WHITELISTED_WALLET_PRIVATE_KEY=
SELLER_AGENT_WALLET_ADDRESS=
SELLER_ENTITY_ID=
BUYER_AGENT_WALLET_ADDRESS=
BUYER_ENTITY_ID=
ACP_TESTNET=1

# ---- NERACA ----
NERACA_DB=./data/neraca.db
