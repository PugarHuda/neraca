# Base wallet - pick ONE of the two blocks below.
# (a) No portal, no account: any Base Sepolia key. `python -m neraca.onchain wallet`
#     mints a pair and prints the faucet links.
NERACA_STAKE_KEY=
NERACA_VAULT=              # second address you control; the guarantee is escrowed here

# (b) CDP server wallets - free keys from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# x402 storefront
NERACA_PAY_TO=            # MAKELAR's wallet address (from `python -m neraca.onchain wallet`)
NERACA_RISK_PRICE=$0.05
NERACA_BUYER_KEY=        # Base Sepolia key holding test USDC, for the paying client

# Virtuals ACP — register agents at https://app.virtuals.io/acp/new (Signers tab)
WHITELISTED_WALLET_PRIVATE_KEY=
SELLER_AGENT_WALLET_ADDRESS=
SELLER_ENTITY_ID=
BUYER_AGENT_WALLET_ADDRESS=
BUYER_ENTITY_ID=
ACP_TESTNET=1             # 1 = Base Sepolia, empty = Base mainnet sandbox

# NERACA
NERACA_DB=./data/neraca.db
